# ============================================================
# Landed Worker — Environment Variables
# Copy this file to .env and fill in all values
# ============================================================

# MongoDB — same connection string as your Next.js app
MONGODB_URI=mongodb+srv://user:password@cluster.mongodb.net/?appName=yourapp

# Encryption key — MUST match ENCRYPTION_KEY in your Next.js app
# Decrypts user credentials (LinkedIn, Indeed, Naukri, Bayt passwords)
# Generate: openssl rand -hex 32
ENCRYPTION_KEY=

# Anthropic — Claude AI for answering custom job application questions
# Get from: console.anthropic.com
ANTHROPIC_API_KEY=

# Worker concurrency — how many browser sessions to run in parallel
# Oracle A1 Free Tier (24GB RAM): set to 3–4
# Each Chromium session uses ~300–400MB RAM
WORKER_CONCURRENCY=2

# Health check port (default 3001)
# The GitHub Actions deploy pipeline checks http://localhost:HEALTH_PORT/health
HEALTH_PORT=3001
